{
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts", "harness/selftest/**/*.ts"],
      "ignore": ["scripts/fixtures/**"],
      "ignoreDependencies": ["@axe-core/playwright"]
    },
    "apps/web": {
      "entry": ["open-next.config.ts", "src/app/**/*.{ts,tsx}"],
      "ignore": ["src/migrations/**", "src/payload-types.ts"],
      "ignoreDependencies": ["@payloadcms/ui"],
      "payload": false
    }
  }
}
