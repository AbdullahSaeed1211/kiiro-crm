{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness lesson front matter",
  "type": "object",
  "required": ["id", "milestone", "class", "severity", "status", "affectedPaths", "countermeasure", "eval", "sourceAttempts"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^L-\\d{8}-M\\d+-[LWX]\\d+[a-z]?-[0-9a-f]{6}$" },
    "milestone": { "type": "string", "pattern": "^M\\d+$" },
    "class": { "type": "string" },
    "severity": { "enum": ["severe", "ordinary"] },
    "status": { "enum": ["active", "retired"] },
    "affectedPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "countermeasure": {
      "type": "object",
      "required": ["type", "location"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["check", "test", "brief-clause", "checklist", "spec-adr"] },
        "location": { "type": "string" }
      }
    },
    "eval": { "type": "string" },
    "sourceAttempts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "retiredReason": { "type": "string" }
  }
}
