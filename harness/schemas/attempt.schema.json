{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work package attempt",
  "type": "object",
  "required": [
    "wp",
    "milestone",
    "attempt",
    "runner",
    "startedAt",
    "finishedAt",
    "gates",
    "scopeViolations",
    "filesChanged",
    "suggestedClasses",
    "confirmedClasses",
    "leadTookOver"
  ],
  "additionalProperties": false,
  "properties": {
    "wp": { "type": "string", "pattern": "^M\\d+-[LWX]\\d+[a-z]?$" },
    "milestone": { "type": "string", "pattern": "^M\\d+$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "runner": { "enum": ["worker", "lead"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "exitCode", "durationMs", "failingLines"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "failingLines": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
        }
      }
    },
    "scopeViolations": { "type": "array", "items": { "type": "string" } },
    "filesChanged": { "type": "integer", "minimum": 0 },
    "suggestedClasses": { "type": "array", "items": { "type": "string" } },
    "confirmedClasses": { "type": "array", "items": { "type": "string" } },
    "leadTookOver": { "type": "boolean" }
  }
}
