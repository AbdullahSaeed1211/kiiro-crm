{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker report front matter",
  "type": "object",
  "required": ["wp", "attempt", "status", "filesChanged", "acceptance", "testsAdded", "choices", "openQuestions"],
  "additionalProperties": false,
  "properties": {
    "wp": { "type": "string", "pattern": "^M\\d+-[LWX]\\d+[a-z]?$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["DONE", "BLOCKED"] },
    "filesChanged": { "type": "array", "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exitCode", "evidence"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "exitCode": { "type": "integer" },
          "evidence": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "testsAdded": { "type": "array", "items": { "type": "string" } },
    "choices": { "type": "array", "items": { "type": "string" } },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "blockedClass": { "type": "string" },
    "dependencyRequests": { "type": "array", "items": { "type": "string" } }
  }
}
