// Local development base config only. Tenant environments are generated by scripts/gen-wrangler.ts (spec §19.2).
// No binding here is remote: builds and local runs never contact Cloudflare (decision E-006).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ops-dev",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "ops-dev",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "ops-dev",
    },
  ],
}
