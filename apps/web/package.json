{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS='--no-deprecation --max-old-space-size=8000' next build --webpack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && NODE_OPTIONS=--no-deprecation payload generate:types"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@payloadcms/db-d1-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-r2": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "graphql": "16.14.2",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.131.1"
  }
}
