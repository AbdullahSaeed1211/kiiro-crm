// Spike tenant (E-003, E-007): workers.dev hostname, throwaway resources deleted after the M1 spike report.
// `host` is the account's workers.dev hostname; `d1.id` is filled by the lead when the database is created.
{
  "slug": "staging-a",
  "displayName": "Staging Alpha",
  "hostType": "workers_dev",
  "host": "ops-staging-a.mirchmedia01.workers.dev",
  "template": "agency",
  "timezone": "America/New_York",
  "locale": "en",
  "currency": "USD",
  "owner": { "email": "owner@example.test", "name": "Spike Owner" },
  "email": {
    "fromName": "Staging Alpha",
    "fromAddress": "no-reply@example.test",
    "inboundDomain": "in.example.test",
    "inboundLocalPrefix": "staging-a--",
  },
  "d1": { "name": "ops-staging-a" },
  "r2": { "bucket": "ops-staging-a" },
  "rateLimitNamespaces": { "intake": "1001", "auth": "1002" },
  "intake": { "allowedOrigins": [], "turnstileHostnames": [] },
  "deployOrder": 0,
}
